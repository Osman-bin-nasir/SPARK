# ============================================================================
# DOCKER ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in the values for your environment

# ============================================================================
# NODE ENVIRONMENT
# ============================================================================
NODE_ENV=development
APP_PORT=8000

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_USER=spark_user
DB_PASSWORD=spark_password
DB_NAME=spark_db
DB_PORT=5432
# The bundled PostgreSQL container does not use TLS. Set true for hosted
# databases that require SSL.
DATABASE_SSL=false

# ============================================================================
# JWT & AUTHENTICATION
# ============================================================================
# Generate secure keys: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_JWT_SECRET=your-refresh-jwt-key-change-in-production
TELEGRAM_JWT_SECRET=your-telegram-jwt-key-change-in-production

# Token expiration times
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ============================================================================
# TELEGRAM BOT INTEGRATION
# ============================================================================
TELEGRAM_BOT_USERNAME=osman80bot

# ============================================================================
# GOOGLE OAUTH
# ============================================================================
# Get these from Google Cloud Console: https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google-drive/callback
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_STATE_EXPIRES_IN=10m
GOOGLE_TOKEN_ENCRYPTION_KEY=

# ============================================================================
# APPLICATION URLs
# ============================================================================
APP_BASE_URL=http://localhost:8000
GOOGLE_DRIVE_POST_CONNECT_URL=http://localhost:8000/integrations

# ============================================================================
# WEBHOOKS & SECURITY
# ============================================================================
WEBHOOK_SECRET=your-webhook-secret-key

# ============================================================================
# AI & EXTRACTION CONFIGURATION
# ============================================================================
# Maximum body size for ingestion (15MB default)
INGESTION_MAX_BODY_BYTES=15728640

# Cleanup interval for orphaned records (milliseconds)
ORPHAN_CLEANUP_INTERVAL_MS=86400000

# Extraction confidence threshold (0-1)
EXTRACTION_CONFIDENCE_THRESHOLD=0.8

# Maximum characters for extracted text
EXTRACTION_MAX_TEXT_CHARS=12000

# ============================================================================
# RAG (RETRIEVAL AUGMENTED GENERATION) CONFIGURATION
# ============================================================================
RAG_MAX_TOP_K=20
RAG_MAX_QUERY_CHARS=512

# ============================================================================
# OPTIONAL: OLLAMA/LANGCHAIN CONFIGURATION
# ============================================================================
# If using local Ollama for AI extraction
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=mistral

# Native automation (no n8n). Set real values in your deployment secret store.
AUTOMATION_ENABLED=true
AUTOMATION_RUN_IN_API=true
AUTOMATION_TIME_ZONE=Asia/Kolkata
AUTOMATION_REPORT_HOUR=9
AUTOMATION_RECOVERY_MS=3600000
AUTOMATION_SHEETS_DELAY_MS=30000
AUTOMATION_RETENTION_DAYS=7
DATABASE_POOL_MAX=8
PUBLIC_API_BASE_URL=https://your-backend.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved WhatsApp report template, with report text in variable {{1}}.
TWILIO_INSIGHTS_CONTENT_SID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OCR_SPACE_API_KEY=
# OCR.space free tier: 1 MB per file, up to 3 PDF pages.
OCR_MAX_FILE_BYTES=1048576
