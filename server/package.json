{
  "name": "spark-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "python-ai:venv": "py -3.12 -m venv .venv",
    "python-ai:install": ".venv\\Scripts\\python.exe -m pip install -r python_ai/requirements.txt",
    "python-ai:dev": ".venv\\Scripts\\python.exe -m uvicorn python_ai.app:app --host 0.0.0.0 --port 8001 --reload"
  },
  "dependencies": {
    "@langchain/core": "^0.3.40",
    "@langchain/ollama": "^0.2.0",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
