NODE_ENV=production
# Render supplies PORT; do not set it manually.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=
REFRESH_JWT_SECRET=
TELEGRAM_JWT_SECRET=
APP_BASE_URL=https://sparkmetrics.online

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.sparkmetrics.online/api/google-drive/callback
GOOGLE_DRIVE_POST_CONNECT_URL=https://sparkmetrics.online/integrations
GOOGLE_TOKEN_ENCRYPTION_KEY=
WEBHOOK_SECRET=

# Native automation. Never put credentials in VITE_* variables.
AUTOMATION_ENABLED=true
AUTOMATION_RUN_IN_API=true
AUTOMATION_TIME_ZONE=Asia/Kolkata
AUTOMATION_REPORT_HOUR=9
# Local wakeups + due-time retries. Sparse recovery handles external retries.
AUTOMATION_RECOVERY_MS=3600000
AUTOMATION_SHEETS_DELAY_MS=30000
# Daily cleanup of old completed queue payloads; 0 disables it. Failed work is kept.
AUTOMATION_RETENTION_DAYS=7
DATABASE_POOL_MAX=8
ORPHAN_CLEANUP_INTERVAL_MS=86400000
PUBLIC_API_BASE_URL=https://api.sparkmetrics.online
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_INSIGHTS_CONTENT_SID=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OCR_SPACE_API_KEY=
OCR_MAX_FILE_BYTES=1048576
