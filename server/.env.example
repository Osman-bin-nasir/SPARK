PORT=4000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_JWT_SECRET=replace-with-a-long-random-refresh-secret
TELEGRAM_JWT_SECRET=replace-with-a-long-random-telegram-secret
APP_BASE_URL=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
WEBHOOK_SECRET=

# Native automation. Never put credentials in VITE_* variables.
AUTOMATION_ENABLED=true
AUTOMATION_RUN_IN_API=true
AUTOMATION_TIME_ZONE=Asia/Kolkata
AUTOMATION_REPORT_HOUR=9
AUTOMATION_POLL_MS=5000
PUBLIC_API_BASE_URL=https://your-backend.example.com
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_INSIGHTS_CONTENT_SID=
GROQ_API_KEY=
